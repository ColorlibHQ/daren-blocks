{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Source Serif throughout",
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--source-serif)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)"
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)"
				}
			},
			"core/categories": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)"
				}
			}
		}
	}
}
